{
  "type": "waplastic_weightedsearch",
  "module": "waplastic",
  "action": "weightedsearch",
  "groupTitle": "Mr Cheese",
  "groupIcon": "fas fa-lg fa-cheese comp-exec",
  "title": "Wap-Lastic Weighted Search",
  "icon": "fas fa-lg fa-search comp-data",
  "outputType": "array",
  "dataPick": true,
  "dataPickObject": true,
  "properties": [
    {
      "group": "Settings",
      "variables": [
        {
          "name": "actionName",
          "optionName": "name",
          "title": "Name",
          "type": "text",
          "required": true,
          "defaultValue": "",
          "baseName": "waplasticSearch",
          "help": "The name for this action step"
        },
        {
          "name": "actionOutput",
          "optionName": "output",
          "title": "Output",
          "type": "boolean",
          "initValue": true,
          "defaultValue": false,
          "help": "Output the results"
        },
        {
          "name": "mode",
          "optionName": "mode",
          "title": "Mode",
          "type": "droplist",
          "values": [
            {
              "title": "From query step (recommended)",
              "value": "query",
              "show": [
                "sourceData",
                "searchColumns",
                "outputColumns",
                "outputSchemaButton",
                "boostColumn",
                "sortColumn",
                "responseFormat"
              ],
              "hide": [
                "connection",
                "queryParams",
                "selectClause",
                "fromJoins",
                "whereClause",
                "primaryKey"
              ]
            },
            {
              "title": "SQL generate (advanced)",
              "value": "sql",
              "show": [
                "connection",
                "queryParams",
                "searchColumns",
                "outputColumns",
                "outputSchemaButton",
                "selectClause",
                "fromJoins",
                "whereClause",
                "primaryKey",
                "boostColumn",
                "sortColumn",
                "responseFormat"
              ],
              "hide": [
                "sourceData"
              ]
            }
          ],
          "defaultValue": "query",
          "help": "Use after a database query step, or generate SQL manually for large datasets"
        }
      ]
    },
    {
      "group": "Query step",
      "variables": [
        {
          "name": "sourceData",
          "optionName": "sourceData",
          "title": "Query results",
          "type": "text",
          "required": true,
          "serverDataBindings": true,
          "defaultValue": "",
          "help": "Use the data picker to select the database query step above (e.g. {{yourQuery}}). Connection comes from that query."
        }
      ]
    },
    {
      "group": "Search input",
      "variables": [
        {
          "name": "searchTerms",
          "optionName": "searchTerms",
          "title": "Search terms",
          "type": "text",
          "required": true,
          "serverDataBindings": true,
          "defaultValue": "",
          "help": "Use the data picker: {{$_GET.q}}, {{$_GET.terms}}, or any binding. Terms are trimmed and lowercased automatically."
        }
      ]
    },
    {
      "group": "Output columns",
      "variables": [
        {
          "name": "outputColumns",
          "optionName": "outputColumns",
          "title": "Columns to return",
          "type": "grid",
          "defaultValue": {},
          "help": "Use the column picker (Wappler may save {{yourQuery[0].columnName}}; the extension extracts columnName). Leave empty to return all query columns. relevance_score and boosted_score are always included. After saving, run the API once so Wappler refreshes step meta for the page picker.",
          "columns": [
            {
              "field": "field",
              "caption": "Column",
              "size": "55%",
              "editable": {
                "type": "datapicker"
              }
            },
            {
              "field": "type",
              "caption": "Type",
              "size": "25%",
              "editable": {
                "type": "droplist",
                "values": [
                  {
                    "title": "Text",
                    "value": "text"
                  },
                  {
                    "title": "Number",
                    "value": "number"
                  },
                  {
                    "title": "Date",
                    "value": "date"
                  },
                  {
                    "title": "Date/time",
                    "value": "datetime"
                  },
                  {
                    "title": "Boolean",
                    "value": "boolean"
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "outputSchemaButton",
          "optionName": "schema",
          "title": "Define output schema",
          "type": "button",
          "command": "dmxSchemaEditor",
          "commandNameParameter": "schema",
          "dialogTitle": "Wap-Lastic output schema",
          "dialogWidth": 420,
          "dialogHeight": 720,
          "noDefaultSave": true,
          "help": "Optional: refine field types for the page picker. Usually you only need output columns + one API test run (updates step meta automatically)."
        },
        {
          "name": "responseFormat",
          "optionName": "responseFormat",
          "title": "API response shape",
          "type": "droplist",
          "values": [
            {
              "title": "Array (best for page picker; bind repeat to step name)",
              "value": "array"
            },
            {
              "title": "Object (success, data, total)",
              "value": "object"
            }
          ],
          "defaultValue": "array",
          "help": "Array returns rows directly (same as a query step). Object wraps rows in { data, total }."
        }
      ]
    },
    {
      "group": "Search columns",
      "variables": [
        {
          "name": "searchColumns",
          "optionName": "searchColumns",
          "title": "Weighted columns",
          "type": "grid",
          "defaultValue": {},
          "help": "Pick columns from your query step. Higher weight = ranked higher.",
          "columns": [
            {
              "field": "field",
              "caption": "Column",
              "size": "40%",
              "editable": {
                "type": "datapicker"
              }
            },
            {
              "field": "weight",
              "caption": "Weight",
              "size": "15%",
              "editable": {
                "type": "static"
              }
            },
            {
              "field": "excludeWhenMatchIn",
              "caption": "Exclude if also in",
              "size": "45%",
              "editable": {
                "type": "static"
              }
            }
          ]
        }
      ]
    },
    {
      "group": "Query parameters",
      "variables": [
        {
          "name": "queryParams",
          "optionName": "queryParams",
          "title": "SQL parameters",
          "type": "grid",
          "defaultValue": {},
          "initDisplay": "none",
          "serverDataBindings": true,
          "help": "SQL generate mode only: map :param names to GET or other bindings",
          "columns": [
            {
              "field": "param",
              "caption": "Parameter",
              "size": "35%",
              "editable": {
                "type": "static"
              }
            },
            {
              "field": "value",
              "caption": "Value",
              "size": "65%",
              "editable": {
                "type": "datapicker"
              }
            }
          ]
        }
      ]
    },
    {
      "group": "Base query",
      "variables": [
        {
          "name": "connection",
          "optionName": "connection",
          "title": "Database Connection",
          "type": "text",
          "initDisplay": "none",
          "defaultValue": "",
          "help": "SQL generate mode only"
        },
        {
          "name": "selectClause",
          "optionName": "selectClause",
          "title": "SELECT columns",
          "type": "textarea",
          "initDisplay": "none",
          "defaultValue": "",
          "help": "SQL generate mode: column list without SELECT keyword"
        },
        {
          "name": "fromJoins",
          "optionName": "fromJoins",
          "title": "FROM / JOIN",
          "type": "textarea",
          "initDisplay": "none",
          "defaultValue": "",
          "help": "SQL generate mode: must start with FROM"
        },
        {
          "name": "whereClause",
          "optionName": "whereClause",
          "title": "WHERE conditions",
          "type": "textarea",
          "initDisplay": "none",
          "defaultValue": "",
          "help": "SQL generate mode: optional filters with :param placeholders"
        },
        {
          "name": "primaryKey",
          "optionName": "primaryKey",
          "title": "Primary key (count)",
          "type": "text",
          "initDisplay": "none",
          "defaultValue": "",
          "help": "SQL generate mode: optional, e.g. p.id"
        }
      ]
    },
    {
      "group": "Scoring",
      "variables": [
        {
          "name": "boostColumn",
          "optionName": "boostColumn",
          "title": "Boost column",
          "type": "text",
          "serverDataBindings": true,
          "defaultValue": "",
          "help": "Optional: use data picker to pick a numeric column from your query for extra ranking boost"
        },
        {
          "name": "boostMultiplier",
          "optionName": "boostMultiplier",
          "title": "Boost multiplier",
          "type": "number",
          "defaultValue": 50,
          "help": "Applied as (column value - 1) * multiplier"
        },
        {
          "name": "minKeywordLength",
          "optionName": "minKeywordLength",
          "title": "Min keyword length",
          "type": "number",
          "defaultValue": 3,
          "help": "Ignore search tokens shorter than this"
        },
        {
          "name": "maxKeywords",
          "optionName": "maxKeywords",
          "title": "Max keywords",
          "type": "number",
          "defaultValue": 10,
          "help": "Maximum words from search terms (max 20)"
        },
        {
          "name": "hideZeroScoreWhenSearching",
          "optionName": "hideZeroScoreWhenSearching",
          "title": "Hide zero-score rows when searching",
          "type": "boolean",
          "defaultValue": true,
          "help": "When searching, only return rows with a relevance score above 0"
        },
        {
          "name": "includeCount",
          "optionName": "includeCount",
          "title": "Include total count",
          "type": "boolean",
          "defaultValue": true,
          "help": "Return total matching rows before pagination"
        }
      ]
    },
    {
      "group": "Pagination and sort",
      "variables": [
        {
          "name": "limit",
          "optionName": "limit",
          "title": "Limit",
          "type": "numberorstring",
          "serverDataBindings": true,
          "defaultValue": 100,
          "help": "Max rows: bind {{$_GET.limit}} or a number"
        },
        {
          "name": "offset",
          "optionName": "offset",
          "title": "Offset",
          "type": "numberorstring",
          "serverDataBindings": true,
          "defaultValue": 0,
          "help": "Row offset: bind {{$_GET.offset}} or a number"
        },
        {
          "name": "sortMode",
          "optionName": "sortMode",
          "title": "Sort mode",
          "type": "droplist",
          "values": [
            {
              "title": "Relevance (boosted score)",
              "value": "relevance"
            },
            {
              "title": "Column ascending",
              "value": "column_asc"
            },
            {
              "title": "Column descending",
              "value": "column_desc"
            }
          ],
          "defaultValue": "relevance"
        },
        {
          "name": "sortColumn",
          "optionName": "sortColumn",
          "title": "Sort column",
          "type": "text",
          "serverDataBindings": true,
          "defaultValue": "",
          "help": "When sorting by column: use data picker to pick a field from your query"
        }
      ]
    }
  ]
}
